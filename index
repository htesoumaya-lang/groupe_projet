<!DOCTYPE html>
<html>
<head>
    <title>Test Landsat Images</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        body { margin: 0; padding: 0; height: 100vh; font-family: Arial; background: #2c3e50; }
        #map { width: 100%; height: 100vh; }
        .debug {
            position: absolute; top: 10px; left: 10px; z-index: 1000;
            background: white; padding: 15px; border-radius: 8px; max-width: 500px;
        }
    </style>
</head>
<body>
    <div id="map"></div>
    <div class="debug" id="debug">
        <h3 style="margin:0 0 10px 0;">🔍 Diagnostic</h3>
        <div id="status">Test en cours...</div>
    </div>

    <script>
        const map = L.map('map').setView([45.5, 12.3], 10);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

        const debug = document.getElementById('debug');
        const status = document.getElementById('status');

        // Test chaque image individuellement
        const bounds = [[45.58, 12.17], [45.40, 12.47]];
        let testsCompleted = 0;
        let imagesFound = 0;

        function testImage(number) {
            const img = new Image();
            const url = `${number}.png`;
            
            img.onload = function() {
                imagesFound++;
                status.innerHTML += `<br>✅ <a href="${url}" target="_blank">${url}</a> - TROUVÉ`;
                
                // Ajouter à la carte
                L.imageOverlay(url, [
                    [45.58 - ((number-1)%3)*0.06, 12.17 + Math.floor((number-1)/3)*0.07],
                    [45.58 - ((number-1)%3 + 1)*0.06, 12.17 + (Math.floor((number-1)/3) + 1)*0.07]
                ]).addTo(map);
            };
            
            img.onerror = function() {
                status.innerHTML += `<br>❌ <a href="${url}" target="_blank">${url}</a> - NON TROUVÉ`;
            };
            
            img.src = url;
        }

        // Tester les 12 images
        status.innerHTML = "Test des images sur GitHub...<br>";
        for (let i = 1; i <= 12; i++) {
            testImage(i);
        }

        // Résumé après 3 secondes
        setTimeout(() => {
            status.innerHTML += `<br><br><b>RÉSULTAT : ${imagesFound}/12 images trouvées</b>`;
            if (imagesFound === 0) {
                status.innerHTML += `<br><br>❌ <b>URGENT : Uploader les images sur GitHub !</b>`;
            }
        }, 3000);

    </script>
</body>
</html>
